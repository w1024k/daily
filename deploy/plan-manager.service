# systemd 服务单元示例
#
# 安装：
#   sudo cp deploy/plan-manager.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now plan-manager
#
# 查看日志：
#   journalctl -u plan-manager -f
#
# 注意：把下面的 User / WorkingDirectory 改成你自己的实际值。

[Unit]
Description=计划管理 (Plan Manager)
Documentation=file:///data/code/daily/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/data/code/daily

# 0.0.0.0 = 监听所有网卡（局域网/公网可直接访问）
# 只想本机访问就改回 127.0.0.1，并配合 Nginx 反向代理对外
Environment=PLAN_HOST=0.0.0.0
Environment=PLAN_PORT=8000
# 走 HTTPS 时打开（配合 Nginx 反向代理）
# Environment=PLAN_COOKIE_SECURE=1

ExecStart=/data/code/daily/.venv/bin/uvicorn app.main:app \
    --host 0.0.0.0 --port 8000

Restart=on-failure
RestartSec=3


[Install]
WantedBy=multi-user.target